<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.EntryTextResultsPage"
             Title="{Binding Name}">
    
    <VerticalStackLayout>

        <Label Text="Result from Entry Page"
               FontSize="Title"
               FontAttributes="Bold"
               TextColor="Blue"
               HorizontalOptions="Center" />

        <BoxView HeightRequest="3" BackgroundColor="Black" WidthRequest="300" />

        <Label Text="{Binding Text}"
               FontSize="Title"
               TextColor="Red"
               FontAttributes="Bold"
               HorizontalOptions="Center" />
        
    </VerticalStackLayout>
</ContentPage>