<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstMAUIApp.View.SwitchVMPage"
             Title="{Binding Title}">
    <VerticalStackLayout>

        <FlexLayout Direction="Column"
                    JustifyContent="Center"
                    AlignItems="Center"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">

            <Label Text="Switch Example" FontSize="Large" TextColor="{Binding TextColor}" FontAttributes="Bold"/>

            <Switch IsToggled="{Binding Toggle}" ThumbColor="Blue" OnColor="Green" />


        </FlexLayout>


    </VerticalStackLayout>
</ContentPage>